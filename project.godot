; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RGP AutoCombo Prototype"
run/main_scene="uid://d1fonqxidgbmt"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

GlobalEvents="*res://src/Globals/GlobalEvents.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="RGP AutoCombo Prototype"

[editor_plugins]

enabled=PackedStringArray("res://addons/PlanarReflectorCpp/plugin.cfg", "res://addons/color-palette/plugin.cfg", "res://addons/proton_scatter/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[global_group]

character=""
snap=""
snap_objects=""
planar_reflectors=""

