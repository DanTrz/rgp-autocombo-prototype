[layer_names]

3d_render/layer_1="Main"
3d_render/layer_19="LightShafts"
3d_render/layer_20="ReflectObjects"
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Enemy"
3d_physics/layer_4="BattleArea"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

[shader_globals]

cloud_shadow_texture={
"type": "sampler2D",
"value": ""
}
cloud_alpha_scissor={
"type": "float",
"value": 0.0
}
cloud_shadow_proj_matrix={
"type": "transform",
"value": Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
}
cloud_shadow_strength={
"type": "float",
"value": 0.0
}
cloud_movement_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_area_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cloud_area_size={
"type": "float",
"value": 0.0
}
sun_light_direction={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
enable_directional_shadows={
"type": "bool",
"value": false
}
shadow_distance={
"type": "float",
"value": 0.0
}
ground_plane_y={
"type": "float",
"value": 0.0
}
cloud_mesh_y={
"type": "float",
"value": 0.0
}
cloud_texture_scale={
"type": "float",
"value": 0.0
}
